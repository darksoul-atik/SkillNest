{
  "name": "skillnest",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @skillnest/api dev",
    "dev:web": "pnpm --filter @skillnest/web dev",
    "build": "turbo build",
    "lint": "turbo lint",
