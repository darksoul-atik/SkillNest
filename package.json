{
  "name": "skillnest-monorepo",
  "version": "1.0.0",
  "description": "SkillNest - Monorepo combining Client & Server",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"cyan,magenta\" \"npm run dev --prefix client\" \"npm run start --prefix server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run start --prefix server",
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "lint:client": "npm run lint --prefix client",
    "preview:client": "npm run preview --prefix client",
    "install:all": "npm install --prefix client && npm install --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "skillnest",
    "hobbyhub",
    "react",
    "vite",
    "express",
    "mongodb",
    "monorepo"
  ],
  "author": "",
  "license": "ISC"
}
