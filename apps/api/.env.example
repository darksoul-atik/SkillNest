# Node Environment
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# DO NOT COMMIT ACTUAL URI/CREDENTIALS
MONGODB_URI=mongodb://localhost:27017/skillnest

# JWT Secrets & Expirations
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_REFRESH_TTL=7d

# Initial Admin Credentials (for seed script)
ADMIN_EMAIL=admin@skillnest.dev
ADMIN_PASSWORD=AdminSecurePassword123!

# Google OAuth (Optional in dev)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# GitHub OAuth (Optional in dev)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# Throttling / Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
